# Dashboard login. Required in production (the "studio" default only works in dev)
DASHBOARD_PASSWORD=studio

# Supabase: required on Vercel for dashboard edits, inquiries and uploads to persist.
# Run supabase/migrations/003_site_document.sql first. The service role key is server-only.
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for canonical links, sitemap and OpenGraph
# NEXT_PUBLIC_SITE_URL=https://klick-berlin.de
